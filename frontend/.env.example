# ─────────────────────────────────────────────────────────────
# إعدادات واجهة Vite — انسخ هذا الملف إلى `.env` عند التطوير.
# (`frontend/.env` مستثنى من git لأنه خاص بكل جهاز.)
#
# VITE_API_URL — عنوان الـ API الذي تستدعيه الواجهة:
#
#   `/api/` (الافتراضي)
#     يمرّ عبر بروكسي Vite أثناء التطوير، وعلى نفس النطاق في الإنتاج
#     (`core/urls.py` يخدم واجهة React من نفس أصل Django). لا حاجة
#     لتعديل أي شيء عند النشر على أصل واحد.
#
#   مسار مطلق مثل `https://api.example.com/api/`
#     يُستخدم فقط عند فصل الواجهة عن الباك إند على **دومينين مختلفين**.
#     في هذه الحالة يجب ضبط إعدادات كوكي الباك إند بدورها:
#         DJANGO_COOKIE_DOMAIN=.example.com
#         DJANGO_COOKIE_SAMESITE=None
#         DJANGO_COOKIE_SECURE=True
#     بدونها تفشل المصادقة كاملةً — لأن Samesite=Lax يمنع إرسال كوكي
#     الجلسة في الطلبات cross-site، فتبدو الواجهة وكأنها لا تسجّل الدخول.
# ─────────────────────────────────────────────────────────────
VITE_API_URL=/api/
