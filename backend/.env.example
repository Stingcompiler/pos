# ─────────────────────────────────────────────────────────────
# انسخ هذا الملف إلى .env ثم عدّل القيم.
# لا تُرفع ملفات .env الحقيقية إلى المستودع أبداً.
# ─────────────────────────────────────────────────────────────

# إعدادات Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=ضع-هنا-مفتاحاً-عشوائياً-طويلاً-وفريداً
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,n1.stingdev.pro
DJANGO_CSRF_TRUSTED_ORIGINS=https://n1.stingdev.pro
DJANGO_CORS_ALLOWED_ORIGINS=https://n1.stingdev.pro

# عملة المؤسسة الوحيدة. الفواتير بعملة أخرى تُرفض، والتقارير تجمع هذه
# العملة فقط، إلى أن يُدعم سعر الصرف صراحةً.
DJANGO_BASE_CURRENCY=SDG
# عملات الشراء التي تُسجَّل لها أسعار صرف لتسعير القطع المستوردة.
DJANGO_PRICING_CURRENCIES=USD,AED,SAR,CNY,EGP

# ─────────────────────────────────────────────────────────────
# التشغيل داخل المحل والنسخ الاحتياطي (docs/OPERATIONS.md)
# ─────────────────────────────────────────────────────────────
# True = النظام على جهاز داخل المحل لأجهزة الشبكة المحلية (بلا HTTPS).
DJANGO_LOCAL_NETWORK=False
# مجلد النسخ: يُفضَّل مجلد متزامن مع Google Drive/Dropbox أو قرص خارجي.
DJANGO_BACKUP_DIR=
DJANGO_BACKUP_KEEP=14
# مفتاح التشفير من: python manage.py backup_data --generate-key
# احفظه في مكان آمن منفصل؛ لا استعادة للنسخ المشفّرة بدونه.
DJANGO_BACKUP_KEY=

# إعدادات قاعدة البيانات (اتركها فارغة لاستخدام SQLite محلياً)
# عند ضبط DB_NAME سيُستخدم PostgreSQL تلقائياً.
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# البريد الإلكتروني (Gmail App Password مثال)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com
# بريد استلام إشعارات الطلبات والرسائل. لا قيمة افتراضية في الكود:
# إن تُرك فارغاً يُسجَّل تحذير ولا يُرسل بريد (بدل إرساله لبريد خاطئ).
ADMIN_NOTIFICATION_EMAIL=your-email@gmail.com

# ─────────────────────────────────────────────────────────────
# إعدادات كوكي المصادقة
# ─────────────────────────────────────────────────────────────
# الحالة الحالية: Django يخدم الواجهة من **نفس الأصل** (core/urls.py)،
# لذا اترك هذه القيم كما هي ولا تلمس DJANGO_COOKIE_DOMAIN.
#
# عند فصل الواجهة عن الباك إند على دومينين مختلفين
# (app.example.com + api.example.com) يجب ضبط الثلاثة معاً:
#     DJANGO_COOKIE_DOMAIN=.example.com
#     DJANGO_COOKIE_SAMESITE=None
#     DJANGO_COOKIE_SECURE=True
# بدونها تفشل المصادقة كاملةً بصمت: Samesite=Lax يمنع إرسال الكوكي في
# الطلبات cross-site، فتبدو الواجهة وكأنها لا تسجّل الدخول.
DJANGO_COOKIE_DOMAIN=
DJANGO_COOKIE_SAMESITE=Lax
DJANGO_COOKIE_SECURE=True

# ─────────────────────────────────────────────────────────────
# إعدادات نشر إضافية
# ─────────────────────────────────────────────────────────────
# إعادة توجيه إلزامية إلى HTTPS — افتراضيه True في الإنتاج (DEBUG=False).
# عطّلها فقط إن كان الوكيل الأمامي (Nginx/Cloudflare) يتولّى الإعادة.
DJANGO_SECURE_SSL_REDIRECT=True

# رابط لوحة التحكم الذي يُرفق في رسائل الإشعارات الإدارية.
# اتركه فارغاً إن لم ترغب بإرفاق رابط — لا نُرسل رابط localhost أبداً
# لأن زرّاً يقود إلى localhost يوهم الأدمن بأن النظام انكسر.
DASHBOARD_BASE_URL=

# خدمة الملفات المرفوعة (media) عبر Django.
# في الإنتاج المثالي اضبطها False واخدم /media/ عبر Nginx أو CDN.
DJANGO_SERVE_MEDIA=True
